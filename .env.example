PORT=3000
HOST=0.0.0.0
DIRECTUS_URL=http://127.0.0.1:8056
# Directus-Adresse für Lizenzbindung (getrennt von der App-PUBLIC_URL).
DIRECTUS_PUBLIC_URL=http://localhost:8056
# start.sh erzeugt diese Werte beim ersten Start in .env.local.
DIRECTUS_ADMIN_EMAIL=admin@example.org
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_ADMIN_TOKEN=
DIRECTUS_SECRET=
PUBLIC_SERVICE_TOKEN=
# Optional: feste WLAN-Adresse für die QR-Codes, ohne abschließenden Schrägstrich.
# PUBLIC_URL=http://192.168.1.50:3000

# Nur bei vertrauenswürdigem HTTPS-Zugang aktivieren; lokales HTTP: false.
APP_SECURE_COOKIES=false
