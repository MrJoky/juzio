# Als .env.server kopieren und an das Hausnetz anpassen.
# Feste IP des Servers im Hausnetz; beide DNS-Namen zeigen auf diese IP.
SERVER_LAN_IP=192.168.1.50
PUBLIC_URL=https://juzio.home.arpa
DIRECTUS_PUBLIC_URL=https://cms.juzio.home.arpa
DIRECTUS_ADMIN_EMAIL=admin@example.org
# Vier verschiedene zufällige Werte; je: openssl rand -hex 32
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_ADMIN_TOKEN=
DIRECTUS_SECRET=
PUBLIC_SERVICE_TOKEN=
